---
import DocsNav from '../components/DocsNav.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
}

const { title, description, eyebrow = 'Documentation' } = Astro.props;
---

<BaseLayout title={`${title} — Signalint`} description={description}>
	<div class="shell docs-shell">
		<DocsNav />
		<article class="docs-content prose">
			<header class="page-heading" data-reveal>
				<div class="page-heading__meta">
					<span>{eyebrow}</span>
					<span>v0.2.0 / schema 1.1</span>
				</div>
				<h1>{title}</h1>
				<p class="lede">{description}</p>
			</header>
			<slot />
		</article>
	</div>
</BaseLayout>
