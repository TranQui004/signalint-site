---
import DocsNav from '../components/docs/DocsNav.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
	version?: string;
	locale?: 'en' | 'vi';
}

const { title, description, eyebrow = 'Documentation', version = '0.4.0', locale = 'en' } = Astro.props;
---

<BaseLayout title={`${title} â€” Signalint`} description={description} locale={locale}>
	<div class="shell docs-shell">
		<DocsNav version={version} locale={locale} />
		<article class="docs-content prose">
			<header class="page-heading" data-reveal>
				<div class="page-heading__meta">
					<span>{eyebrow}</span>
					<span>v{version} / {version === '0.1.0' ? 'archived docs' : 'schema 1.2'}</span>
				</div>
				<h1>{title}</h1>
				<p class="lede">{description}</p>
			</header>
			<slot />
		</article>
	</div>
</BaseLayout>
