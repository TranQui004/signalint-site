---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.astro';
import DiagnosticStory from '../components/DiagnosticStory.astro';
import EngineFlow from '../components/EngineFlow.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cacheKey = `sha256(file content)
: engine
: engine config hash
: signalint version
: engine version`;
const loopWarning = `{
  "signature": "no-unused-vars:<identifier> is unused",
  "occurrences": 3,
  "hint": "This issue was fixed and reappeared 3 times — consider a different approach"
}`;
const fanout = `"engines": {
  "oxlint": { "status": "ok" },
  "tsc": { "status": "error", "message": "..." },
  "biome": { "status": "disabled" }
}`;
---

<BaseLayout
	title="Signalint — compact diagnostics for coding agents"
	description="Published local MCP server for compact, cached, loop-aware JavaScript and TypeScript diagnostics."
>
	<section class="hero-v2">
		<div class="shell hero-v2__grid">
			<div class="hero-v2__copy" data-reveal>
				<p class="eyebrow">Local stdio MCP / signalint-mcp@0.2.0</p>
				<h1>Engine diagnostics.<br /><span>Agent-sized responses.</span></h1>
				<p class="lede">
					Signalint is a local stdio MCP server that runs Oxlint, TypeScript, and optional
					Biome checks—then caches unchanged work, clusters repeated issues, and flags
					fix loops before sending a versioned response back to the coding agent.
				</p>
				<div class="hero-actions">
					<a class="button" href={`${base}docs/`}>Read the setup</a>
					<a class="button secondary" href="https://github.com/TranQui004/signalint">Inspect the source ↗</a>
				</div>
			</div>
			<div class="hero-ledger" data-reveal>
				<div class="hero-ledger__label"><span>Runtime manifest</span><span>local process</span></div>
				<div class="ledger-row"><span>Transport</span><span>local / stdio</span></div>
				<div class="ledger-row"><span>Package</span><span>signalint-mcp@0.2.0</span></div>
				<div class="ledger-row"><span>Engines</span><span>oxlint / tsc / biome</span></div>
				<div class="ledger-row"><span>Response</span><span>schemaVersion 1.1</span></div>
				<div class="ledger-row"><span>License</span><span>MIT</span></div>
			</div>
		</div>
		<div class="hero-command">
			<div class="shell hero-command__inner">
				<div class="hero-command__label">Install from npm</div>
				<CopyCommand command="npm install --save-dev signalint-mcp && npx signalint-mcp init" />
			</div>
		</div>
	</section>

	<section class="proof-strip" aria-label="Measured and contractual facts">
		<div class="shell proof-strip__grid">
			<div class="proof-stat" data-reveal>
				<span class="micro-label">Payload reduction</span>
				<strong>86.53%</strong>
				<p>Current 40-issue fixture: 9,151 B raw versus 1,233 B clustered.</p>
			</div>
			<div class="proof-stat" data-reveal>
				<span class="micro-label">Incremental check</span>
				<strong>3.10 ms</strong>
				<p>Latest local acceptance run; the enforced ceiling is 300 ms for the 50-file fixture.</p>
			</div>
			<div class="proof-stat" data-reveal>
				<span class="micro-label">Fixture compression</span>
				<strong>40 → 4</strong>
				<p>Forty raw issues grouped into four rule-first clusters.</p>
			</div>
			<div class="proof-stat" data-reveal>
				<span class="micro-label">Input boundary</span>
				<strong>512</strong>
				<p>Maximum project-relative paths accepted in one MCP call.</p>
			</div>
		</div>
	</section>

	<section class="section section--ruled section--story">
		<div class="shell">
			<header class="section-heading" data-reveal>
				<p class="section-index">01 / response</p>
				<h2>See what the agent sees.</h2>
				<p>Scroll through the recorded 40-issue fixture as normalized rows become a bounded schema 1.1 response.</p>
			</header>
			<div class="hairline" data-rule></div>
			<DiagnosticStory />
		</div>
	</section>

	<section class="section section--ruled section--pipeline">
		<div class="shell">
			<header class="section-heading" data-reveal>
				<p class="section-index">02 / mechanics</p>
				<h2>A local pipeline with explicit boundaries.</h2>
				<p>Signalint preserves the diagnostic engines as the source of truth and makes cache, failure, and loop state explicit.</p>
			</header>
			<EngineFlow />
			<div class="capability-grid">
				<article class="capability-card wide" data-reveal>
					<span class="capability-card__number">01 — cache identity</span>
					<h3>Version-aware reuse</h3>
					<p>A result is reused only when file content, the recognized root engine-config hash, Signalint code version, and the installed engine version still match.</p>
					<pre><code>{cacheKey}</code></pre>
				</article>
				<article class="capability-card" data-reveal>
					<span class="capability-card__number">02 — loop memory</span>
					<h3>Oscillation is visible</h3>
					<p>An issue that disappears and returns repeatedly produces a narrow warning, not a guess about the wider conversation.</p>
					<pre><code>{loopWarning}</code></pre>
				</article>
				<article class="capability-card" data-reveal>
					<span class="capability-card__number">03 — engine fan-out</span>
					<h3>Partial results survive</h3>
					<p>One engine can fail without discarding diagnostics another engine already completed.</p>
					<pre><code>{fanout}</code></pre>
				</article>
				<article class="capability-card" data-reveal>
					<span class="capability-card__number">04 — process boundary</span>
					<h3>Bounded execution</h3>
					<p>Default deadlines are 30 seconds for Oxlint, 120 seconds for tsc, and 30 seconds for Biome. Timeout and cancellation terminate the process tree.</p>
				</article>
				<article class="capability-card" data-reveal>
					<span class="capability-card__number">05 — storage</span>
					<h3>Local state stays bounded</h3>
					<p>The SQLite cache evicts least-recently-used rows above 10,000 entries. Session history replays a bounded tail and rotates to a single <code>.1</code> backup.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section section--ruled section--engines">
		<div class="shell">
			<header class="section-heading" data-reveal>
				<p class="section-index">03 / engines</p>
				<h2>Each engine keeps its execution model.</h2>
				<p>File-local engines receive cache misses. TypeScript always sees the complete program when it runs.</p>
			</header>
			<table class="engine-table" data-reveal>
				<thead><tr><th>Engine</th><th>Invocation</th><th>Signalint cache role</th><th>Default timeout</th></tr></thead>
				<tbody>
					<tr><td>Oxlint</td><td>Batch of changed file-local paths</td><td>Per engine + file</td><td>30,000 ms</td></tr>
					<tr><td>Biome</td><td>Batch of changed file-local paths</td><td>Per engine + file</td><td>30,000 ms</td></tr>
					<tr><td>TypeScript</td><td><code>--project</code>, or <code>--build</code> for referenced roots</td><td>Decides whether whole-program tsc runs</td><td>120,000 ms</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section class="section section--clients">
		<div class="shell">
			<header class="section-heading" data-reveal>
				<p class="section-index">04 / clients</p>
				<h2>Connect the server where the agent works.</h2>
				<p>The init command detects nearby client configuration and writes an entry only after confirmation.</p>
			</header>
			<div class="client-grid">
				<article class="client-card" data-reveal>
					<h3>Claude Code <span>.mcp.json</span></h3>
					<p>Project-scoped configuration with a shareable server entry.</p>
					<code>claude mcp add --scope project signalint …</code>
				</article>
				<article class="client-card" data-reveal>
					<h3>Cursor <span>.cursor/mcp.json</span></h3>
					<p>Local project configuration using the published npm binary.</p>
					<code>npx --no-install signalint-mcp</code>
				</article>
				<article class="client-card" data-reveal>
					<h3>Antigravity <span>mcp_config.json</span></h3>
					<p>Detected user configuration with explicit project working directory.</p>
					<code>cmd /c npx --no-install signalint-mcp</code>
				</article>
			</div>
			<div class="hero-actions" data-reveal>
				<a class="button" href={`${base}docs/`}>Read the setup guide</a>
				<a class="button secondary" href={`${base}docs/tools/`}>Inspect the schemas</a>
			</div>
		</div>
	</section>
</BaseLayout>
