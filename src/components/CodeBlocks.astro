<script>
	import { gsap } from 'gsap';

	type TokenClass = 'comment' | 'flag' | 'keyword' | 'number' | 'punctuation' | 'string' | 'property';

	const jsonTokenPattern = /"(?:\\.|[^"\\])*"|-?\b\d+(?:\.\d+)?\b|\b(?:true|false|null)\b|[{}[\],:]/g;
	const codeTokenPattern = /\/\/.*$|#.*$|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|--?[\w-]+|\b(?:const|let|var|import|export|from|return|async|await|true|false|null|npm|npx|node|pnpm|claude|signalint)\b|\b\d+(?:\.\d+)?\b|[{}[\]():,=>|&]+/gm;

	const inferLabel = (value: string): string => {
		const trimmed = value.trimStart();
		if (trimmed.startsWith('{') || trimmed.startsWith('[')) return 'JSON';
		if (/^(?:npm|npx|node|claude|pnpm)\s/m.test(trimmed)) return 'Terminal';
		if (trimmed.startsWith('Signalint session stats')) return 'Output';
		return 'Code';
	};

	const classifyToken = (token: string, source: string, index: number, label: string): TokenClass => {
		if (token.startsWith('//') || token.startsWith('#')) return 'comment';
		if (token.startsWith('-')) return 'flag';
		if (token.startsWith('"') || token.startsWith("'")) {
			const isProperty = label === 'JSON' && /^\s*:/.test(source.slice(index + token.length));
			return isProperty ? 'property' : 'string';
		}
		if (/^-?\d/.test(token)) return 'number';
		if (/^(?:const|let|var|import|export|from|return|async|await|true|false|null|npm|npx|node|pnpm|claude|signalint)$/.test(token)) return 'keyword';
		return 'punctuation';
	};

	const highlightCode = (target: HTMLElement, source: string, label: string): void => {
		const pattern = label === 'JSON' ? jsonTokenPattern : codeTokenPattern;
		const fragment = document.createDocumentFragment();
		let cursor = 0;

		for (const match of source.matchAll(pattern)) {
			const index = match.index ?? 0;
			if (index > cursor) fragment.append(document.createTextNode(source.slice(cursor, index)));

			const token = document.createElement('span');
			token.className = `syntax-token syntax-token--${classifyToken(match[0], source, index, label)}`;
			token.textContent = match[0];
			fragment.append(token);
			cursor = index + match[0].length;
		}

		if (cursor < source.length) fragment.append(document.createTextNode(source.slice(cursor)));
		target.replaceChildren(fragment);
		target.classList.add('syntax-code');
	};

	document.querySelectorAll<HTMLPreElement>('pre:not([data-no-copy])').forEach((pre) => {
		if (pre.closest('[data-code-frame]') !== null || pre.closest('[data-passive-demo]') !== null) return;
		const code = pre.querySelector<HTMLElement>('code') ?? pre;
		const source = code.textContent ?? '';
		const frameLabel = pre.dataset.label ?? inferLabel(source);

		const frame = document.createElement('div');
		frame.className = 'code-frame';
		frame.dataset.codeFrame = '';

		const toolbar = document.createElement('div');
		toolbar.className = 'code-frame__toolbar';

		const label = document.createElement('span');
		label.textContent = frameLabel;

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-frame__copy';
		button.setAttribute('aria-label', 'Copy code to clipboard');
		button.innerHTML = '<svg aria-hidden="true" viewBox="0 0 16 16"><rect x="5" y="5" width="8" height="8"></rect><path d="M3 11H2V2h9v1"></path></svg><span>Copy</span>';

		pre.parentNode?.insertBefore(frame, pre);
		frame.append(toolbar, pre);
		toolbar.append(label, button);
		highlightCode(code, source, frameLabel);

		button.addEventListener('click', async () => {
			const status = button.lastElementChild;
			try {
				await navigator.clipboard.writeText(source);
				if (status !== null) status.textContent = 'Copied';
			} catch {
				if (status !== null) status.textContent = 'Failed';
			}
			gsap.fromTo(button, { y: -2 }, { y: 0, duration: 0.32, ease: 'power3.out' });
			window.setTimeout(() => {
				if (status !== null) status.textContent = 'Copy';
			}, 1400);
		});
	});
</script>
