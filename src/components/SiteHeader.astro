---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = Astro.url.pathname;
const links = [
	{ label: 'Docs', path: 'docs/' },
	{ label: 'Changelog', path: 'changelog/' },
	{ label: 'Open source', path: 'open-source/' },
];

const hrefFor = (path: string) => `${base}${path}`;
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href={base} aria-label="Signalint home">
			<span class="wordmark-mark" aria-hidden="true"><i></i><i></i><i></i></span>
			<span>signalint</span>
		</a>
		<nav class="site-nav" aria-label="Primary navigation">
			{links.map((link) => (
				<a href={hrefFor(link.path)} aria-current={currentPath.includes(`/${link.path}`) ? 'page' : undefined}>
					{link.label}
				</a>
			))}
			<a href="https://github.com/TranQui004/signalint">GitHub <span aria-hidden="true">↗</span></a>
		</nav>
		<a class="package-state" href="https://www.npmjs.com/package/signalint-mcp" aria-label="Signalint 0.2.0 on npm">
			<span>npm</span>
			<strong>0.2.0</strong>
		</a>
	</div>
</header>
