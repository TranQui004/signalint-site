<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const revealTargets = gsap.utils.toArray<HTMLElement>('[data-reveal]');
	const rules = gsap.utils.toArray<HTMLElement>('[data-rule]');
	const counters = gsap.utils.toArray<HTMLElement>('[data-count]');
	const clientSections = gsap.utils.toArray<HTMLElement>('[data-client-section]');
	const motionGroups = gsap.utils.toArray<HTMLElement>('[data-motion-group]');
	const motionCards = gsap.utils.toArray<HTMLElement>('[data-motion-card], .capability-card, .engine-profile, .client-entry, .feature-card');
	const footer = document.querySelector<HTMLElement>('[data-footer-reveal]');

	if (!reducedMotion) {
		revealTargets.forEach((target) => {
			gsap.fromTo(target, {
				autoAlpha: 0,
				y: 28,
			}, {
				autoAlpha: 1,
				y: 0,
				duration: 0.9,
				ease: 'power3.out',
				scrollTrigger: {
					trigger: target,
					start: 'top 88%',
					once: true,
				},
			});
		});

		rules.forEach((rule) => {
			gsap.from(rule, {
				scaleX: 0,
				duration: 1.05,
				ease: 'power3.inOut',
				transformOrigin: 'left center',
				scrollTrigger: {
					trigger: rule,
					start: 'top 94%',
					once: true,
				},
			});
		});

		counters.forEach((counter) => {
			const target = Number(counter.dataset.count);
			const decimals = Number(counter.dataset.countDecimals ?? '0');
			if (!Number.isFinite(target)) return;
			if (!Number.isInteger(decimals) || decimals < 0 || decimals > 3) return;
			const state = { value: 0 };
			gsap.to(state, {
				value: target,
				duration: 1.35,
				ease: 'power3.out',
				onUpdate: () => {
					counter.textContent = decimals === 0
						? String(Math.round(state.value))
						: state.value.toFixed(decimals);
				},
				scrollTrigger: { trigger: counter, start: 'top 88%', once: true },
			});
		});

		clientSections.forEach((section) => {
			const heading = section.querySelectorAll<HTMLElement>('[data-client-heading] > *');
			const entries = section.querySelectorAll<HTMLElement>('[data-client-entry]');
			gsap.set([...heading, ...entries], { autoAlpha: 0, y: 30 });
			gsap.timeline({
				scrollTrigger: { trigger: section, start: 'top 74%', once: true },
			})
				.to(heading, { autoAlpha: 1, y: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out' })
				.to(entries, { autoAlpha: 1, y: 0, stagger: 0.14, duration: 0.75, ease: 'power3.out' }, '-=0.25');
		});

		motionGroups.forEach((group) => {
			const children = Array.from(group.children).filter((child): child is HTMLElement => child instanceof HTMLElement);
			if (children.length === 0) return;
			gsap.fromTo(children, {
				autoAlpha: 0,
				y: 32,
			}, {
				autoAlpha: 1,
				y: 0,
				stagger: 0.09,
				duration: 0.82,
				ease: 'power3.out',
				scrollTrigger: { trigger: group, start: 'top 84%', once: true },
			});
		});

		if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
			motionCards.forEach((card) => {
				const enter = () => gsap.to(card, { y: -6, duration: 0.42, ease: 'power2.out', overwrite: 'auto' });
				const leave = () => gsap.to(card, { y: 0, duration: 0.55, ease: 'power3.out', overwrite: 'auto' });
				card.addEventListener('pointerenter', enter);
				card.addEventListener('pointerleave', leave);
			});
		}

		if (footer !== null) {
			const footerItems = footer.querySelectorAll<HTMLElement>('[data-footer-item]');
			gsap.fromTo(footerItems, {
				autoAlpha: 0,
				y: 36,
			}, {
				autoAlpha: 1,
				y: 0,
				stagger: 0.12,
				duration: 0.85,
				ease: 'power3.out',
				scrollTrigger: { trigger: footer, start: 'top 92%', once: true },
			});
		}
	}

	window.addEventListener('pagehide', () => {
		ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
	});
</script>
