<section id="engine-flow" class="flow-demo" data-engine-flow data-passive-demo aria-label="Animated Signalint request flow">
	<div class="flow-demo__topline">
		<span>check_files</span>
		<span>request lifecycle / passive demo</span>
	</div>
	<div class="flow-demo__canvas">
		<div class="flow-node flow-node--request" data-flow-node>
			<span>01</span>
			<strong>MCP call</strong>
			<code>3 paths</code>
		</div>
		<div class="flow-connector" aria-hidden="true"><i data-flow-line></i></div>
		<div class="flow-engine-stack" data-flow-engines>
			<div><span>oxlint</span><strong>1 miss</strong></div>
			<div><span>tsc</span><strong>whole project</strong></div>
			<div><span>biome</span><strong>disabled</strong></div>
		</div>
		<div class="flow-connector" aria-hidden="true"><i data-flow-line></i></div>
		<div class="flow-node" data-flow-node>
			<span>03</span>
			<strong>Cluster</strong>
			<code>40 → 4</code>
		</div>
		<div class="flow-connector" aria-hidden="true"><i data-flow-line></i></div>
		<div class="flow-node flow-node--response" data-flow-node>
			<span>04</span>
			<strong>Response</strong>
			<code>schema 1.1</code>
		</div>
	</div>
	<div class="flow-demo__status">
		<div><i></i><span>oxlint</span><strong>ok</strong></div>
		<div><i></i><span>tsc</span><strong>ok</strong></div>
		<div class="is-muted"><i></i><span>biome</span><strong>disabled</strong></div>
		<p>One failing engine cannot discard another engine's completed diagnostics.</p>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	document.querySelectorAll<HTMLElement>('[data-engine-flow]').forEach((demo) => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const nodes = demo.querySelectorAll<HTMLElement>('[data-flow-node]');
		const engineRows = demo.querySelectorAll<HTMLElement>('[data-flow-engines] > div');
		const lines = demo.querySelectorAll<HTMLElement>('[data-flow-line]');
		const statuses = demo.querySelectorAll<HTMLElement>('.flow-demo__status > div');
		const compact = window.matchMedia('(max-width: 900px)').matches;

		gsap.set([...nodes, ...engineRows, ...statuses], { autoAlpha: 0, y: 16 });
		gsap.set(lines, compact
			? { scaleY: 0, transformOrigin: 'top center' }
			: { scaleX: 0, transformOrigin: 'left center' });
		const lineReveal = compact ? { scaleY: 1 } : { scaleX: 1 };

		const timeline = gsap.timeline({
			scrollTrigger: {
				trigger: demo,
				start: 'top 78%',
				end: 'bottom 42%',
				scrub: 0.75,
			},
		});

		timeline
			.to(nodes[0], { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out' })
			.to(lines[0], { ...lineReveal, duration: 0.65, ease: 'power2.inOut' }, '-=0.25')
			.to(engineRows, { autoAlpha: 1, y: 0, stagger: 0.12, duration: 0.65, ease: 'power3.out' }, '-=0.2')
			.to(lines[1], { ...lineReveal, duration: 0.65, ease: 'power2.inOut' }, '-=0.2')
			.to(nodes[1], { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.25')
			.to(lines[2], { ...lineReveal, duration: 0.65, ease: 'power2.inOut' }, '-=0.2')
			.to(nodes[2], { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.25')
			.to(statuses, { autoAlpha: 1, y: 0, stagger: 0.1, duration: 0.55, ease: 'power3.out' }, '-=0.2');
	});
</script>
