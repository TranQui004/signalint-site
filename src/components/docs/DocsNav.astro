---
import DocsVersionPicker from './DocsVersionPicker.astro';

interface Props {
	version?: string;
	locale?: 'en' | 'vi';
}

const { version = '0.2.0', locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = Astro.url.pathname;
const localePrefix = locale === 'vi' ? 'vi/' : '';
const links = [
	{ label: locale === 'vi' ? 'Bắt đầu' : 'Getting started', path: 'docs/' },
	{ label: locale === 'vi' ? 'Cài đặt & client' : 'Setup & clients', path: 'docs/setup/' },
	{ label: locale === 'vi' ? 'Cấu hình' : 'Configuration', path: 'docs/configuration/' },
	{ label: 'MCP tools', path: 'docs/tools/' },
	{ label: locale === 'vi' ? 'CLI & số liệu' : 'CLI & metrics', path: 'docs/cli/' },
	{ label: locale === 'vi' ? 'Kiến trúc' : 'Architecture', path: 'docs/architecture/' },
	{ label: locale === 'vi' ? 'Bảo mật' : 'Security model', path: 'docs/security/' },
	{ label: 'FAQ', path: 'docs/faq/' },
	{ label: locale === 'vi' ? 'Khắc phục lỗi' : 'Troubleshooting', path: 'docs/troubleshooting/' },
];

const hrefFor = (path: string) => `${base}${localePrefix}${path}`;
const normalizedCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
---

<aside class="docs-sidebar" aria-label={locale === 'vi' ? 'Điều hướng tài liệu' : 'Documentation navigation'}>
	<div class="docs-sidebar__head">
		<p class="docs-sidebar-title">{locale === 'vi' ? 'Tài liệu' : 'Documentation'}</p>
		<span class="docs-sidebar-meta">v{version} / {version === '0.1.0' ? 'archive' : 'schema 1.1'}</span>
		<DocsVersionPicker version={version} locale={locale} />
	</div>
	<nav>
		{links.map((link, index) => {
			const href = hrefFor(link.path);
			return (
				<a href={href} aria-current={normalizedCurrent === href ? 'page' : undefined}>
					<span>{String(index + 1).padStart(2, '0')}</span>
					<strong>{link.label}</strong>
				</a>
			);
		})}
	</nav>
</aside>
