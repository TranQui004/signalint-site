---
import DocsVersionPicker from './DocsVersionPicker.astro';

interface Props {
	version?: string;
}

const { version = '0.2.0' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = Astro.url.pathname;
const links = [
	{ label: 'Getting started', path: 'docs/' },
	{ label: 'Setup & clients', path: 'docs/setup/' },
	{ label: 'Configuration', path: 'docs/configuration/' },
	{ label: 'MCP tools', path: 'docs/tools/' },
	{ label: 'CLI & metrics', path: 'docs/cli/' },
	{ label: 'Architecture', path: 'docs/architecture/' },
	{ label: 'Security model', path: 'docs/security/' },
	{ label: 'FAQ', path: 'docs/faq/' },
	{ label: 'Troubleshooting', path: 'docs/troubleshooting/' },
];

const hrefFor = (path: string) => `${base}${path}`;
const normalizedCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
---

<aside class="docs-sidebar" aria-label="Documentation navigation">
	<div class="docs-sidebar__head">
		<p class="docs-sidebar-title">Documentation</p>
		<span class="docs-sidebar-meta">v{version} / {version === '0.1.0' ? 'archive' : 'schema 1.1'}</span>
		<DocsVersionPicker version={version} />
	</div>
	<nav>
		{links.map((link, index) => {
			const href = hrefFor(link.path);
			return (
				<a href={href} aria-current={normalizedCurrent === href ? 'page' : undefined}>
					<span>{String(index + 1).padStart(2, '0')}</span>
					<strong>{link.label}</strong>
				</a>
			);
		})}
	</nav>
</aside>
