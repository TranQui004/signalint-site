---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface Props {
	stickyReveal?: boolean;
	locale?: 'en' | 'vi';
}

const { stickyReveal = false, locale = 'en' } = Astro.props;
const prefix = locale === 'vi' ? 'vi/' : '';
---

<footer class:list={['site-footer', { 'site-footer--sticky': stickyReveal }]} data-footer-reveal={stickyReveal ? '' : undefined}>
	<div class="shell footer-grid">
		<div data-footer-item={stickyReveal ? '' : undefined}>
			<p class="footer-kicker">{locale === 'vi' ? 'MCP cục bộ / stdio' : 'Local MCP / stdio'}</p>
			<p class="footer-title">{locale === 'vi' ? 'Giữ chẩn đoán thật sự hữu ích.' : 'Keep diagnostics useful.'}</p>
			<p class="footer-summary-note">{locale === 'vi' ? 'Signalint miễn phí, mã nguồn mở theo MIT License.' : 'Signalint is free and open source under the MIT License.'}</p>
		</div>
		<div class="footer-col" aria-label={locale === 'vi' ? 'Liên kết tài liệu' : 'Documentation links'} data-footer-item={stickyReveal ? '' : undefined}>
			<strong>{locale === 'vi' ? 'Tham khảo' : 'Reference'}</strong>
			<a href={`${base}${prefix}docs/`}>{locale === 'vi' ? 'Tài liệu' : 'Documentation'}</a>
			<a href={`${base}${prefix}docs/tools/`}>MCP tools</a>
			<a href={`${base}${prefix}docs/architecture/`}>{locale === 'vi' ? 'Kiến trúc' : 'Architecture'}</a>
			<a href={`${base}${prefix}blog/`}>Blog</a>
		</div>
		<div class="footer-col" aria-label={locale === 'vi' ? 'Liên kết dự án' : 'Project links'} data-footer-item={stickyReveal ? '' : undefined}>
			<strong>{locale === 'vi' ? 'Dự án' : 'Project'}</strong>
			<a href="https://www.npmjs.com/package/signalint-mcp">npm package</a>
			<a href="https://github.com/TranQui004/signalint">GitHub</a>
			<a href="https://github.com/TranQui004">TranQui004 profile</a>
			<a href="https://github.com/TranQui004/signalint/issues">Issues</a>
			<a href={`${base}${prefix}changelog/`}>Changelog</a>
		</div>
	</div>
	<div class="shell footer-bottom" data-footer-item={stickyReveal ? '' : undefined}>
		<span>signalint-mcp@0.2.0 / schema 1.1</span>
		<span>{locale === 'vi' ? 'JavaScript + TypeScript / phát triển công khai' : 'JavaScript + TypeScript / built in public'}</span>
	</div>
</footer>
