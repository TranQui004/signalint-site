---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div>
			<p class="footer-title">Signalint</p>
			<p>Compact, cached, loop-aware diagnostics for coding agents.</p>
			<p class="footer-summary-note">Free and open source under the MIT License.</p>
		</div>
		<div class="footer-col" aria-label="Documentation links">
			<strong>Reference</strong>
			<a href={`${base}docs/`}>Documentation</a>
			<a href={`${base}docs/tools/`}>MCP tools</a>
			<a href={`${base}docs/architecture/`}>Architecture</a>
			<a href={`${base}docs/security/`}>Security model</a>
		</div>
		<div class="footer-col" aria-label="Project links">
			<strong>Project</strong>
			<a href="https://www.npmjs.com/package/signalint-mcp">npm package</a>
			<a href="https://github.com/TranQui004/signalint">GitHub</a>
			<a href="https://github.com/TranQui004/signalint/issues">Issues</a>
			<a href={`${base}changelog/`}>Changelog</a>
		</div>
	</div>
	<div class="shell footer-bottom">
		<span>signalint-mcp@0.2.0 · schema 1.1</span>
		<span>Local stdio MCP · JavaScript / TypeScript</span>
	</div>
</footer>
