---
interface Props {
	locale: 'en' | 'vi';
	discussionNumber: number;
	discussionUrl: string;
}

const { locale, discussionNumber, discussionUrl } = Astro.props;
---

<section class="blog-comments" aria-labelledby="comments-title" data-reveal>
	<header>
		<p class="section-index">{locale === 'vi' ? 'Thảo luận / GitHub' : 'Discussion / GitHub'}</p>
		<h2 id="comments-title">{locale === 'vi' ? 'Trao đổi thêm về bài viết' : 'Continue the discussion'}</h2>
		<p>
			{locale === 'vi'
				? 'Bình luận được lưu trong GitHub Discussions. Bạn đăng nhập bằng tài khoản GitHub; website không tạo tài khoản và không lưu dữ liệu người dùng.'
				: 'Comments live in GitHub Discussions. You sign in with GitHub; this site creates no account and stores no user data.'}
		</p>
	</header>
	<div class="github-comment-card motion-card" data-motion-card>
		<div class="github-comment-card__embed">
			<script
				is:inline
				src="https://giscus.app/client.js"
				data-repo="TranQui004/signalint-site"
				data-repo-id="R_kgDOTqc15w"
				data-category="General"
				data-category-id="DIC_kwDOTqc1584DChAb"
				data-mapping="number"
				data-term={String(discussionNumber)}
				data-strict="1"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme="light"
				data-lang={locale === 'vi' ? 'vi' : 'en'}
				data-loading="lazy"
				crossorigin="anonymous"
				async
			></script>
		</div>
		<p class="github-comment-card__fallback"><a href={discussionUrl}>{locale === 'vi' ? 'Mở trực tiếp trên GitHub ↗' : 'Open directly on GitHub ↗'}</a></p>
	</div>
</section>
