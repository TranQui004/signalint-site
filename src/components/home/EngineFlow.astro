---
import type { FlowCopy } from '../../content/site/types';

interface Props {
	copy: FlowCopy;
}

const { copy } = Astro.props;
---

<section id="engine-flow" class="flow-demo" data-engine-flow data-passive-demo aria-label={copy.ariaLabel}>
	<header class="flow-intake" data-flow-intro>
		<div>
			<span class="micro-label">{copy.incomingLabel}</span>
			<strong><code>check_files</code></strong>
		</div>
		<dl>
			<div><dt>{copy.inputLabel}</dt><dd>{copy.inputValue}</dd></div>
			<div><dt>{copy.workingDirectoryLabel}</dt><dd>{copy.workingDirectoryValue}</dd></div>
			<div><dt>{copy.executionLabel}</dt><dd>{copy.executionValue}</dd></div>
		</dl>
	</header>

	<ol class="flow-steps">
		{copy.steps.map((step, index) => (
			<li class="flow-step" data-flow-step>
				<span class="flow-step__number">{String(index + 1).padStart(2, '0')}</span>
				<div class="flow-step__copy">
					<span>{step.kicker}</span>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</div>
				{index === 1 ? (
					<div class="flow-engine-list" data-flow-engines>
						{copy.engineResults.map((engine) => <div><span>{engine.name}</span><strong>{engine.value}</strong></div>)}
					</div>
				) : step.result ? <code class="flow-step__result">{step.result}</code> : null}
			</li>
		))}
	</ol>

	<footer class="flow-outcomes" data-flow-outcomes>
		{copy.outcomes.map((outcome) => <div class:list={{ 'is-muted': outcome.muted }}><span>{outcome.name}</span><strong>{outcome.value}</strong></div>)}
		<p>{copy.outcomeNote}</p>
	</footer>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	document.querySelectorAll<HTMLElement>('[data-engine-flow]').forEach((demo) => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const section = demo.closest<HTMLElement>('[data-pipeline-section]');
		const headingParts = section?.querySelectorAll<HTMLElement>('.section-heading > *') ?? [];
		const intro = demo.querySelector<HTMLElement>('[data-flow-intro]');
		const steps = demo.querySelectorAll<HTMLElement>('[data-flow-step]');
		const outcomes = demo.querySelector<HTMLElement>('[data-flow-outcomes]');
		const targets = [
			...headingParts,
			...(intro === null ? [] : [intro]),
			...steps,
			...(outcomes === null ? [] : [outcomes]),
		];

		gsap.set(targets, { autoAlpha: 0, y: 26 });

		const timeline = gsap.timeline({
			scrollTrigger: {
				trigger: section ?? demo,
				start: 'top 72%',
				once: true,
			},
		});

		timeline
			.to(headingParts, { autoAlpha: 1, y: 0, stagger: 0.11, duration: 0.85, ease: 'power3.out' })
			.to(intro, { autoAlpha: 1, y: 0, duration: 0.75, ease: 'power3.out' }, '-=0.3')
			.to(steps, { autoAlpha: 1, y: 0, stagger: 0.16, duration: 0.8, ease: 'power3.out' }, '-=0.25')
			.to(outcomes, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.3');
	});
</script>
